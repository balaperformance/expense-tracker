# Public Supabase settings for the browser. Both values are designed to be
# public: the anon (publishable) key grants nothing by itself, and every row
# is protected by row-level security.
#
# NEVER put the service-role / secret key, a database URL, or any AI provider
# key here — anything prefixed VITE_ is bundled into the JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: the PUBLIC half of the Web Push (VAPID) key pair, for push notifications.
# Generate the pair once with: npx web-push generate-vapid-keys
# The PRIVATE half never belongs here — it is a secret of the push-notify Edge Function.
# VITE_VAPID_PUBLIC_KEY=
