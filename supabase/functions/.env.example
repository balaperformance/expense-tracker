# Edge Function secrets. Copy to supabase/functions/.env for local `supabase
# functions serve`, or push straight to the project:
#
#   supabase secrets set --env-file supabase/functions/.env
#
# supabase/functions/.env is git-ignored. Never put these in the app's .env.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. Defaults are current free-tier models with tool calling.
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
